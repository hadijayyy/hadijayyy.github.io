# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Elysium mainnet RPC (chain 99901). Published by Kinetiq at mainnet launch.
ELYSIUM_RPC_URL=

# Hot wallet that pays gas for launches. Keep only a little HYPE in it.
# Leave empty to run read-only (scan + alerts, no launches).
LAUNCHER_PRIVATE_KEY=

# Your approved Ascend builder address. Ascend's multisig must set a cap for it first.
# Leave empty to launch without a builder fee.
BUILDER_ADDRESS=
# Builder fee to request, in percent (max 1, and never above your on-chain cap)
BUILDER_FEE_PERCENT=0.5

# 1 = simulate only, never send a transaction. Set to 0 to launch for real.
DRY_RUN=1

# Anti-spam
LAUNCH_COOLDOWN_HOURS=24
MAX_LAUNCHES_PER_HOUR=20

# Optional: Telegram channel/group id that receives every new Ascend launch
ALERT_CHAT_ID=
# Language of channel alerts: en or id
ALERT_LANG=en

# Where user wallets and rate limits are stored
DATA_FILE=./data.json
